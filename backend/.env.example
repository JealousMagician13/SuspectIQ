NODE_ENV=development
PORT=8000

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File upload limits
MAX_FILE_SIZE_MB=500

# Upload directory
UPLOAD_DIR=uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Python inference
PYTHON_BIN=python
INFERENCE_TIMEOUT_MS=300000
